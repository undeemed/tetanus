{
  // `upstream/` is deliberately not type-checked. It was written against a
  // pnpm workspace whose type-only imports reach 68 packages and about 40,000
  // lines that never run - checking it here would mean vendoring all of them
  // to prove something upstream's own CI already proves. What must be right is
  // OUR side of the seam, so `src/` is checked strictly and the vendored
  // package names resolve to `any`.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"]
  },
  "include": ["src", "types"],
  "exclude": ["upstream", "dist"]
}
