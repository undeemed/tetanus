{
  "name": "tetanus-panel",
  "private": true,
  "type": "module",
  "description": "The browser panel: DeepSeek Harness's conversation view over the tetanus JSON-RPC carrier",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "test:upstream": "PANEL_SUITE=upstream vitest run",
    "test:upstream:coverage": "PANEL_SUITE=upstream vitest run --coverage.enabled",
    "test:engine": "vitest run tests/engine.e2e.spec.ts",
    "test:vendored:coverage": "PANEL_SUITE=vendored vitest run --coverage.enabled"
  },
  "dependencies": {
    "@shikijs/langs": "^4.4.3",
    "anser": "^2.3.2",
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^1.29.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "^4.0.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^4.1.11"
  }
}
